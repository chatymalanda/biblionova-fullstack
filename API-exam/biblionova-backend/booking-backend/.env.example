PORT=3000

# Connexion à la base MySQL (Railway, PlanetScale, ou locale)
DB_HOST=changeme.proxy.rlwy.net
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=railway

# JWT — génère une longue chaîne aléatoire (ex: openssl rand -hex 32)
JWT_SECRET=changeme_generate_a_long_random_secret
JWT_EXPIRES_IN=7d

# (Optionnel) URL du frontend, pour restreindre le CORS en production
# CORS_ORIGIN=https://biblionova-fullstack.vercel.app
